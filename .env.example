# Copy to .env for local runs (never commit .env)
PORT=3000
# Google sign-in: OAuth client ID of type "Web application"
GOOGLE_CLIENT_ID=
# Comma-separated Google accounts with administrator rights (can add other instructors)
INSTRUCTOR_EMAILS=you@example.com
# Shown on the About page
CONTACT_EMAIL=
# Long random string; required in production
SESSION_SECRET=
# Postgres connection string; leave empty locally to store data in ./data as JSON files
DATABASE_URL=
# Local testing only: adds a name/email sign-in form (ignored when NODE_ENV=production)
DEV_LOGIN=1
